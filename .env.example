# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chỉ dùng ở server (API route). TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Kiểm duyệt nội dung ----
# OpenAI omni-moderation (miễn phí, nhận cả ảnh + text)
OPENAI_API_KEY=sk-...

# Sightengine: lớp thứ hai, chuyên phát hiện nudity/gore/CSAM
SIGHTENGINE_API_USER=000000000
SIGHTENGINE_API_SECRET=xxxxxxxxxxxxxxxx

# closed  = không có provider nào trả lời -> từ chối ảnh (an toàn nhất)
# review  = không có provider nào trả lời -> đưa vào hàng chờ người duyệt
MODERATION_FAIL_MODE=review

# Chỉ bật khi dev local, cho phép upload không cần API kiểm duyệt.
ALLOW_UNSCREENED=false

# ---- Admin ----
ADMIN_PASSWORD=doi-mat-khau-nay
ADMIN_COOKIE_SECRET=chuoi-ngau-nhien-32-ky-tu

# ---- Cron (Vercel tự gửi header Authorization: Bearer $CRON_SECRET) ----
CRON_SECRET=chuoi-ngau-nhien-khac

# ---- Tuỳ chọn ----
# Bật nếu project Supabase có Image Transformation (gói Pro) để trả thumbnail nhẹ hơn.
NEXT_PUBLIC_IMAGE_TRANSFORMS=0
